{
  "name": "nemonaut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vendor": "node tools/vendor.mjs",
    "build": "node tools/build.mjs",
    "pretest": "node tools/build.mjs --quiet",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json && node tools/type-hardness.mjs --check && node tools/type-precision.mjs --check && node tools/module-graph.mjs --check && prettier --check --log-level warn \"src/**/*.ts\" \"worker/*.ts\" \"tools/*.mjs\" \"tests/*.mjs\"",
    "dev": "node tools/serve.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"worker/*.ts\" \"tools/*.mjs\" \"tests/*.mjs\""
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@types/three": "0.180.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
