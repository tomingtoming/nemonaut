// Public release of Nemonaut: static assets on Cloudflare Workers plus one small Worker route,
// POST /metric → Workers Analytics Engine (anonymous play metrics, docs/metrics.md).
// Assets are matched first; only a path with no asset reaches the Worker (worker/index.ts), which
// hands everything except /metric back to the assets binding, so a missing page is still answered
// by the assets layer.
// Deploy only with tools/deploy-cloudflare.sh: it builds dist (gitignored) from committed src.
{
  "name": "nemonaut",
  "compatibility_date": "2026-10-23",
  "main": "worker/index.ts",
  "assets": { "directory": "dist", "binding": "ASSETS" },
  "routes": [{ "pattern": "nemonaut.toming.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs: the Worker prints one line per metric batch, which shows a live pipeline
  // without running a query.
  "observability": { "enabled": true },
  // Free plan: 100,000 data points written per day for the whole account.
  "analytics_engine_datasets": [{ "binding": "PLAY", "dataset": "nemonaut_play" }],
  // Per-address limit for /metric: a visit posts a handful of batches, so 30 a minute leaves room
  // for many players behind one address while one script cannot spend the write budget.
  // namespace_id is a label chosen per account, not a resource that has to exist.
  "ratelimits": [{ "name": "METRIC_RATE", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } }]
}
