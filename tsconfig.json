{
 // Strict type check of the TypeScript in src (types are stripped by tools/build.mjs); nothing is emitted.
 // tools/type-hardness.mjs additionally forbids explicit any and ts-ignore comments.
  // three.js is typed through the .d.ts next to its vendor copy; physics.ts types the Rust engine facade.
 "compilerOptions": {
  "noEmit": true,
  "target": "es2022",
  "module": "esnext",
  "moduleResolution": "bundler",
  "lib": ["es2023", "dom", "dom.iterable"],
  "types": [],
  "skipLibCheck": true,
  "verbatimModuleSyntax": true,
  "strict": true
 },
 "include": ["src/*.ts"]
}
