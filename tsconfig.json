{
 // Type-checks the plain JS (and .ts) in src with JSDoc and inference; nothing is emitted, delivery is unchanged.
 // Files still carrying `// @ts-nocheck` are typing debt (BACKLOG 4a/4d): remove the line once the file passes.
 // three.js is typed through the .d.ts next to its vendor copy; physics.ts types the Rust engine facade.
 "compilerOptions": {
  "allowJs": true,
  "checkJs": true,
  "noEmit": true,
  "target": "es2022",
  "module": "esnext",
  "moduleResolution": "bundler",
  "lib": ["es2023", "dom", "dom.iterable"],
  "types": [],
  "skipLibCheck": true,
  "verbatimModuleSyntax": true
 },
 "include": ["src/*.js", "src/*.ts"]
}
