{
  // Strict type check of the Worker (wrangler bundles it at deploy; nothing is emitted here).
  // The Request/Response types come from the dom lib; the two bindings are typed in metric.ts.
  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "types": [],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "strict": true
  },
  "include": ["*.ts"]
}
